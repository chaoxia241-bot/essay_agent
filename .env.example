# 复制为 .env 后填写；不要提交真实密钥
LITAGENT_ENV=dev
LITAGENT_LOG_LEVEL=INFO

# LLM（ADR-004：OpenAI 兼容协议，供应商可切换）
# 当前 configs/models.yaml 的 extraction/synthesis/planner 共用此凭据。
LONGCAT_API_KEY=
EMBEDDING_API_KEY=
RERANKER_API_KEY=
# 供应商 base_url 在 configs/models.yaml 中配置

# Neo4j（docker-compose 默认值，生产请修改）
NEO4J_PASSWORD=litagent_dev

# Qdrant（本地默认无需鉴权）
QDRANT_API_KEY=

# 可观测（可选）
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
